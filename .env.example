# Firebase Data Connect Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_DATA_CONNECT_SERVICE_ID=itam-dataconnect
FIREBASE_DATA_CONNECT_LOCATION=us-central1

# Service Account Key (JSON string) — OR set GOOGLE_APPLICATION_CREDENTIALS to a file path
FIREBASE_SERVICE_ACCOUNT_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Application
NEXT_PUBLIC_APP_NAME=IT Asset Manager
